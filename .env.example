# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# The key NEVER goes in chat, logs, or code — only in this file, which only
# the pipeline reads at runtime.

# OpenRouter key for the BEAR-Jev fork testing ONLY ("Bear test tool").
# Must never be the same key the main BEAR repo runs on.
OPENROUTER_API_KEY=sk-or-...

# Jev model pin (decisions API). Pin the snapshot rather than the ~latest alias
# until thresholds are tuned.
JEV_MODEL=typesafe/jev-1.13

# eBay credentials for Agent 2 (same values as the main repo's shell exports)
EBAY_APP_ID=
EBAY_CERT_ID=