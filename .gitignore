# macOS
.DS_Store

# Prose docs — deliberately excluded pending a rewrite; a master file will replace them.
# Files are on disk, just untracked. Remove this line to start tracking them.
docs/

# Session working notes — handoffs and context snapshots, prose in flux
session-notes/

# Claude Code local settings (machine-specific)
.claude/

# Secrets — API keys live here, never in chat, never in git.
.env
*.env
harness/.env

# Dependencies
harness/.pi/npm/node_modules/

# Python
__pycache__/
*.pyc

# Harness working copies — canonical copies are tracked under tests/
harness/photos/
harness/output/
harness/agent2_dummy_input.md
harness/agent3_dummy_input.md

# Stray duplicate of .pi/agents left behind by a pipeline run. Its agent1 copy is
# missing `tools: read` and would reintroduce the recursion bug if restored. Delete it.
harness/agents/

# Ad-hoc test scripts from debugging sessions
harness/test_*.sh
harness/test_subagent.md

# Real customer job data must never be committed. It lives OUTSIDE this repo at
# ~/Desktop/ebay-jobs/ — these patterns are a safety net in case anything lands here.
jobs/
job-data/
real-data/
*_job/

# Operator test photos (real job data) — never commit
harness/photos-base/
bear2/cache/
bear2/spend.jsonl
bear2/runs/

# any env variant (e.g. .env.previous-unread, .env.local) - only the template is tracked
.env.*
!.env.example
.venv/
