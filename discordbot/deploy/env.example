# BEAR Discord bot settings. setup.sh copies this to /opt/bear/.env (only readable by the bear
# user). Edit it with:  nano /opt/bear/.env   then:  systemctl restart bear-bot
# Keys and the token NEVER go in chat, logs or code - only in this file.

# --- BEAR (the same keys the Mac uses) ---
OPENROUTER_API_KEY=PASTE_HERE
EBAY_APP_ID=PASTE_HERE
EBAY_CERT_ID=PASTE_HERE

# --- Discord (discordbot/SETUP.md, part 2) ---
DISCORD_TOKEN=PASTE_HERE
# Right-click the server icon > Copy Server ID (needs Developer Mode on)
DISCORD_GUILD_ID=PASTE_HERE
# Right-click the error channel > Copy Channel ID
ERROR_CHANNEL_ID=PASTE_HERE
# #update-log (setup_server.py makes it). Blank: the channel named update-log is used.
#UPDATE_CHANNEL_ID=
# #part-id (setup_server.py makes it): a photo posted there gets Agent 1's raw read back.
# Blank: the channel named part-id is used.
#PART_ID_CHANNEL_ID=
# Right-click the "Cars" category > Copy Category ID. Text-only messages are deleted in its channels.
CARS_CATEGORY_ID=PASTE_HERE

# --- Running BEAR (changes here need no restart, except BEAR_MAX_RUNS / BEAR_UPLOAD_WAIT /
#     BEAR_RENAME_DOWNLOADS / BEAR_ZIP_MB) ---
# Folders that run at the same time; a 3rd waits in the queue.
BEAR_MAX_RUNS=2
# Most one folder may spend, in US dollars (about 0.2p per part, so this is a safety net).
BEAR_RUN_CAP_USD=3
# Seconds with no new photo before /run starts.
BEAR_UPLOAD_WAIT=30
# Seconds /run gives people to type a SKU to rename the photos (blank = not renamed).
# Raise it if a minute is too short; it applies to the next /run, no restart.
BEAR_RENAME_WAIT=60
# Photos downloaded at once for renaming, across all channels (keeps memory down; renames
# themselves have no limit). Biggest zip posted, in MiB: 10 is Discord's limit without boosts.
#BEAR_RENAME_DOWNLOADS=6
#BEAR_ZIP_MB=10
# Name model, if Qwen keeps failing: google/gemini-3.1-flash-lite or anthropic/claude-haiku-5.5
#BEAR_NAME_MODEL=google/gemini-3.1-flash-lite
# Shadow test (discordbot/shadow.py): 0 turns it off. A note in the error channel every this many
# 💸 photos; put your Discord user ID (right-click your name > Copy User ID) to be @mentioned.
#BEAR_SHADOW=0
#BEAR_SHADOW_PING_PARTS=300
#BEAR_SHADOW_PING_USER=

# Is BEAR up? (discordbot/SETUP.md, part 7) The healthchecks.io ping URL; the bot checks in every
# 10 minutes and healthchecks says in the error channel when it stops. Needs a restart.
#BEAR_HEARTBEAT_URL=https://hc-ping.com/your-check-uuid

# DEV MODE: fake runs, no credits spent. Delete this line (or put # in front) to go live.
# Other scenarios to rehearse errors: rate-limit, no-response, unusable, crash
BEAR_SIM=ok
